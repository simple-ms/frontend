# Environment Configuration
# Copy this file to .env and update with your values

# API Configuration
VITE_API_BASE_URL=http://localhost
VITE_API_TIMEOUT=30000

# Authentication
VITE_TOKEN_EXPIRY=3600
VITE_REFRESH_TOKEN_EXPIRY=604800
VITE_AUTO_REFRESH=true

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_CSRF=true
VITE_ENABLE_XSS_PROTECTION=true

# Rate Limiting
VITE_RATE_LIMIT_LOGIN_ATTEMPTS=5
VITE_RATE_LIMIT_LOGIN_WINDOW=900000
VITE_RATE_LIMIT_API_ATTEMPTS=100
VITE_RATE_LIMIT_API_WINDOW=60000

# Features
VITE_ENABLE_REGISTRATION=true
VITE_ENABLE_PASSWORD_RESET=true
VITE_ENABLE_SOCIAL_LOGIN=false
VITE_ENABLE_TWO_FACTOR=false

# Logging
VITE_LOG_LEVEL=info
VITE_LOG_SENSITIVE_DATA=false

# Cache
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=300000

# Development
VITE_DEV_MODE=true
VITE_ENABLE_CONSOLE=true
